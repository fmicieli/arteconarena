---
import Icon from './Icon.astro';
import { links } from '../data/site';
const nav = [
  { href: '#sand-art', label: 'El Sand Art' },
  { href: '#galeria', label: 'Galería' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#contacto', label: 'Contacto' },
];
---
<header class="header stage">
  <div class="container header__inner">
    <a href="#inicio" class="brand" aria-label="Arte con Arena, inicio">
      <span class="hand brand__mark">Arte con Arena</span>
    </a>
    <nav aria-label="Principal" class="nav">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn--small" href={links.whatsapp} target="_blank" rel="noopener">
      <Icon name="whatsapp" /><span>Consultar</span>
    </a>
  </div>
</header>

<style>
  .header {
    position: sticky; top: 0; z-index: 50;
    background: rgb(36 28 25 / 0.88);
    backdrop-filter: saturate(1.2) blur(12px);
    -webkit-backdrop-filter: saturate(1.2) blur(12px);
    border-bottom: 1px solid rgb(225 204 199 / 0.08);
  }
  .header__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-4); min-height: 4.25rem; }
  .brand { text-decoration: none; color: var(--sand-200); }
  .brand__mark { font-size: 1.75rem; display: block; }
  .nav { display: none; }
  .nav ul { display: flex; gap: var(--sp-6); list-style: none; padding: 0; }
  .nav a {
    color: var(--text-on-stage-soft); text-decoration: none; font-size: var(--fs-sm); font-weight: 600;
    padding-block: var(--sp-2); background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: color 200ms, background-size 400ms var(--ease-out);
  }
  .nav a:hover { color: var(--cream-100); background-size: 100% 1px; }
  .btn--small { min-height: 2.75rem; padding: 0.55rem 1.1rem; }
  @media (min-width: 48rem) { .nav { display: block; } }
</style>
