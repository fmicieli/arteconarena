---
import '@fontsource/quicksand/latin-500.css';
import '@fontsource/quicksand/latin-600.css';
import '@fontsource/quicksand/latin-700.css';
import '@fontsource/caveat/latin-500.css';
import '../styles/global.css';
import { site, links, asset } from '../data/site';

const canonical = new URL(import.meta.env.BASE_URL, Astro.site).href;
const ogImage = new URL(asset('og.jpg'), Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${canonical}#marina`,
      name: site.artist,
      jobTitle: 'Artista de Sand Art',
      email: site.email,
      telephone: '+5492324476673',
      url: canonical,
      sameAs: [links.facebook, links.instagram, links.youtube],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${canonical}#arteconarena`,
      name: site.name,
      description: site.description,
      url: canonical,
      image: ogImage,
      email: site.email,
      telephone: '+5492324476673',
      areaServed: { '@type': 'Country', name: 'Argentina' },
      founder: { '@id': `${canonical}#marina` },
      sameAs: [links.facebook, links.instagram, links.youtube],
      // TODO(clienta): sumar dirección/ciudad base (address) si quiere aparecer en búsquedas locales.
    },
  ],
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#241C19" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Marina Viviana López dibujando con arena en vivo, con la obra proyectada en pantalla" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
    <script>
      // Revela elementos y dibuja trazos al entrar en pantalla.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
      );
      document.querySelectorAll('.reveal, .stroke').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
