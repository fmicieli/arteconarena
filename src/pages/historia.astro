---
/**
 * PRUEBA INTERNA — relato en arena guiado por el scroll.
 * No reemplaza la home ni está enlazada desde el sitio. Marcada como noindex.
 */
import '@fontsource/quicksand/latin-500.css';
import '@fontsource/quicksand/latin-700.css';
import '@fontsource/caveat/latin-500.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { links, asset } from '../data/site';

const chapters = [
  { text: 'Todo empieza con un grano', from: 0.0, to: 0.25, still: 0.24 },
  { text: 'Cada historia tiene un comienzo', from: 0.29, to: 0.64, still: 0.63 },
  { text: '…y la arena la transforma', from: 0.68, to: 0.9, still: 1 },
];
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Relato en arena (prueba) · Arte con Arena</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#241C19" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
  </head>
  <body class="story-body">
    <a class="story__back" href={import.meta.env.BASE_URL}>← Arte con Arena</a>

    <main>
      <section class="story" aria-label="Relato en arena">
        <div class="story__sticky">
          <p class="story__intro">
            <span class="eyebrow">Arte con Arena</span>
            <span class="hand story__hint">Deslizá para empezar <Icon name="down" /></span>
          </p>
          <canvas class="story__canvas" aria-hidden="true"></canvas>
          <canvas class="story__hands" aria-hidden="true"></canvas>
          <ol class="story__captions">
            {chapters.map((c) => (
              <li class="story__caption hand" data-from={c.from} data-to={c.to}>{c.text}</li>
            ))}
          </ol>
        </div>
      </section>

      <div class="story__stills" hidden>
        {chapters.map((c) => (
          <figure class="story__still">
            <canvas data-still={c.still} aria-hidden="true"></canvas>
            <figcaption class="hand">{c.text}</figcaption>
          </figure>
        ))}
      </div>

      <section class="story__end">
        <p class="hand story__end-pre">Esta historia continuará…</p>
        <h2 class="h-section">¿Contamos la tuya?</h2>
        <div class="story__end-actions">
          <a class="btn" href={links.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" /> Consultá por tu evento</a>
          <a class="btn btn--ghost" href={import.meta.env.BASE_URL}>Ver el sitio</a>
        </div>
      </section>
    </main>

    <script>
      import { mountStory } from '../scripts/sand-story';
      mountStory();
    </script>

    <style>
      .story-body { background: var(--earth-900); color: var(--cream-100); }
      .story__back {
        position: fixed; z-index: 10; top: 1rem; left: 1rem;
        padding: 0.5rem 0.9rem; border-radius: 999px; font-size: var(--fs-sm); font-weight: 700;
        text-decoration: none; color: var(--sand-200); background: rgb(36 28 25 / 0.6); backdrop-filter: blur(6px);
      }

      /* 4 tramos de scroll: mesa vacía + 3 capítulos. Cada capítulo se dibuja solo al llegar. */
      .story { height: 400svh; position: relative; }
      .story__sticky { position: sticky; top: 0; height: 100svh; overflow: hidden; background: var(--earth-900); }
      /* La mesa ocupa toda la pantalla; el dibujo va al centro y alrededor queda la franja de arena. */
      .story__canvas, .story__hands { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
      /* Mano sobre el vidrio: fuera de foco y sin grano, como en los videos. */
      .story__hands { filter: blur(1.6px); pointer-events: none; }

      .story__intro {
        position: absolute; left: 0; right: 0; bottom: calc(100% - var(--box-top, 10svh) + 0.5rem); z-index: 2;
        display: flex; flex-direction: column; align-items: center; gap: 0.2rem; text-align: center;
      }
      .story__intro .eyebrow { color: var(--sand-500); }
      .story__hint { display: inline-flex; align-items: center; gap: 0.4rem; font-size: var(--fs-hand); color: var(--sand-200); }
      .story__hint :global(svg) { width: 1.25rem; height: 1.25rem; animation: nudge 1.8s ease-in-out infinite; }
      @keyframes nudge { 50% { transform: translateY(5px); } }

      /* Los títulos de capítulo, escritos sobre la franja de arena de abajo. */
      .story__captions {
        position: absolute; left: var(--gutter); right: var(--gutter); top: calc(var(--box-bottom, 85svh) + 0.75rem); z-index: 2;
        list-style: none; padding: 0; margin: 0; display: grid;
      }
      .story__caption {
        grid-area: 1 / 1; text-align: center; opacity: 0;
        font-size: clamp(1.9rem, 1.2rem + 3vw, 3.25rem); color: var(--sand-200);
        text-shadow: 0 2px 12px rgb(20 14 12 / 0.8);
        /* Se "escribe" de izquierda a derecha. */
        clip-path: inset(0 var(--write, 100%) 0 0);
      }

      .story__stills { display: grid; gap: 3rem; padding: 5rem var(--gutter); max-width: 60rem; margin-inline: auto; }
      .story__still canvas { width: 100%; aspect-ratio: 3 / 2; border-radius: 1rem; display: block; }
      .story__still figcaption { margin-top: 0.75rem; text-align: center; font-size: 2rem; color: var(--sand-200); }

      .story__end { min-height: 80svh; display: grid; place-content: center; justify-items: center; gap: 1rem; text-align: center; padding: 4rem var(--gutter); }
      .story__end-pre { font-size: var(--fs-hand); color: var(--sand-500); }
      .story__end-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 1rem; }
    </style>
  </body>
</html>
